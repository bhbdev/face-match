# Copy to .env to override the defaults. Everything works without it.

POSTGRES_USER=facematch
POSTGRES_PASSWORD=facematch
POSTGRES_DB=facematch

# Wikimedia asks API clients to identify themselves with contact info
# (an email or a URL). Set this before running `make download`.
COMMONS_CONTACT=

# Must match the URL you use to open the web UI.
WEB_ORIGIN=http://localhost:3000
